module Bindan
  class SecretManagerHelper
    @project_id: String?
    @_secret_manager: untyped

    def initialize: (?project_id: String?, ?sdk: untyped, **untyped kwargs) -> void
    attr_reader project_id: String?
    def last_version: (String secret_id) -> untyped
    def update: (String secret_id, data: String) -> untyped
    def revert: (String secret_id, version: String | Integer) -> untyped
  end
end
