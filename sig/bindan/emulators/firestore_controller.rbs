module Bindan
  module Emulator
    #
    # Represents and controls a single instance of the Google Cloud Firestore emulator service.
    # This class checks readiness and clears test data without managing containers.
    #
    class FirestoreController
      WAIT_TIMEOUT: 60

      INITIAL_BACKOFF_KEY_SEC: ::Float

      BACKOFF_MULTIPLIER: ::Float

      class Error < StandardError
      end

      @project_id: String
      @readiness_error: StandardError?

      attr_reader project_id: String

      #
      # Select the project used by the integration tests.
      #
      def initialize: (?project_id: String) -> void

      #
      # Wait for an SDK read, retrying false with bounded exponential backoff.
      #
      # @raise [Error] when the overall deadline expires, including during a check
      # @param [number] timeout
      # @param [number] backoff
      # @param [number] multiplier
      # @return [self] after a successful SDK read
      #
      def wait_available: (?timeout: untyped, ?backoff: untyped, ?multiplier: untyped, ?with_message: bool) -> untyped

      def endpoint: () -> String
      def clear: (?timeout: Numeric) -> FirestoreController

      private

      def sdk_ready?: (Numeric timeout) -> bool
      def delete_documents: (String path, Numeric timeout) -> Net::HTTPResponse
    end
  end
end
