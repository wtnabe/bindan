module GRPC
  module Core
    class Channel
      def self.new: (String target, Hash[String, untyped] args, Symbol credentials) -> Channel
      def close: () -> void
    end
  end
end

module Google
  module Cloud
    class Error < StandardError
    end

    class UnavailableError < Error
    end

    class DeadlineExceededError < Error
    end
  end
end

module Bindan
  module Emulator
    class SecretManagerController
      WAIT_TIMEOUT: 60

      class Error < StandardError
      end

      @project_id: String
      @channel: GRPC::Core::Channel
      @client: untyped

      attr_reader project_id: String
      attr_reader client: untyped

      def initialize: (?project_id: String) -> void
      def endpoint: () -> String
      def wait_available: (?timeout: Integer | Float) -> SecretManagerController
      def clear: () -> SecretManagerController
      def close: () -> void

      private

      def sdk_ready?: (Integer | Float timeout) -> bool
    end
  end
end
