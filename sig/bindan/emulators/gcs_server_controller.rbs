module Bindan
  module Emulator
    class GcsServerController
      class ContainerCannotOpenError < Error
      end

      WAIT_TIMEOUT: 15

      INITIAL_BACKOFF_KEY_SEC: ::Float

      BACKOFF_MULTIPLIER: ::Float

      #
      # @return [bool]
      #
      def running?: () -> bool

      #
      # waits container to be running
      #
      # @raise [ContainerCannotOpenError] if the container does not become available within the configured timeout.
      # @param [number] timeout
      # @param [number] backoff
      # @param [number] multiplier
      # @return [self]
      #
      def wait_available: (?timeout: Numeric, ?backoff: Numeric, ?multiplier: Numeric) -> GcsServerController

      private

      def read_status: () -> Net::HTTPResponse
    end
  end
end
